# Set these in Vercel Project Settings -> Environment Variables

# Added automatically when you connect the Upstash Redis integration
# from the Vercel Storage tab. Names may come through as either pair:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (or, on older "Vercel KV" style integrations)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Protects /api/tick from being spammed.
# Set this in Vercel AND as a GitHub Actions secret named CRON_SECRET.
CRON_SECRET=change-me-to-something-random
