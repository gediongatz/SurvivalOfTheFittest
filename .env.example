# Set these in Vercel Project Settings -> Environment Variables (not committed).

# Added automatically when you connect the Upstash Redis integration
# from the Vercel Storage tab. Names may come through as either pair:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (or, on older "Vercel KV" style integrations)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Make these up yourself (any random strings) — they protect the write endpoints.
CRON_SECRET=change-me-to-something-random
ADMIN_SECRET=change-me-to-something-else-random
